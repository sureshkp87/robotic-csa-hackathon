<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <calculatedFormula>RowCount - CDF1:SUM</calculatedFormula>
        <datatype>number</datatype>
        <description>Total number of IVR calls completed without a transfer to agents.</description>
        <developerName>FORMULA1</developerName>
        <downGroupingContext>GRAND_SUMMARY</downGroupingContext>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Calls Completed in IVR</masterLabel>
        <scale>2</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>((RowCount - CDF1:SUM)/RowCount)*100</calculatedFormula>
        <datatype>number</datatype>
        <description>Percentage of IVR calls completed without a transfer to agents.</description>
        <developerName>FORMULA2</developerName>
        <downGroupingContext>GRAND_SUMMARY</downGroupingContext>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>IVR Containment Rate</masterLabel>
        <scale>2</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>(CDF1:SUM/RowCount)*100</calculatedFormula>
        <datatype>number</datatype>
        <description>Percentage of IVR calls that were transferred to agents.</description>
        <developerName>FORMULA3</developerName>
        <downGroupingContext>GRAND_SUMMARY</downGroupingContext>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>IVR Hand-Off Rate</masterLabel>
        <scale>2</scale>
    </aggregates>
